{
  "name": "bauhaus-dark",
  "type": "dark",
  "colors": {
    "editor.foreground": "#eeeeee",
    "editor.background": "#2f2f2f"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#bdbdbd",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol",
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#fbbe00"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "keyword.operator",
        "punctuation.accessor",
        "variable.parameter",
        "support.constant",
        "markup.quote"
      ],
      "settings": {
        "foreground": "#ffb74d"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.operator.word",
        "storage",
        "storage.type",
        "invalid",
        "message.error"
      ],
      "settings": {
        "foreground": "#ff8a80"
      }
    },
    {
      "scope": [
        "entity.name",
        "entity.name.function",
        "entity.name.label",
        "entity.other.attribute-name",
        "variable.function",
        "variable.annotation",
        "string.other.link",
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8ab4f8"
      }
    },
    {
      "scope": [
        "variable.member",
        "support.function",
        "support.macro",
        "meta.diff",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#f5a0c0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.tag",
        "entity.other.inherited-class",
        "variable.language",
        "punctuation.definition.tag",
        "support.type",
        "support.class",
        "meta.tag.sgml",
        "markup.list",
        "markup.table"
      ],
      "settings": {
        "foreground": "#4dd0c4"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#81c995"
      }
    },
    {
      "scope": [
        "markup.strike",
        "meta.separator"
      ],
      "settings": {
        "foreground": "#7a7a7a"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ff8a80",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffb74d",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#ffb74d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8ab4f8",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff8a80"
      }
    }
  ]
}
